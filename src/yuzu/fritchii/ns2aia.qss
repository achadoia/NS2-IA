/* NS2-IA (Nintendo Switch 2 Achado IA): neobrutalismo AchadoIA.
   Creme, tinta preta, bordas grossas, cantos retos, sombra dura (borda direita/inferior mais
   grossa), cores chapadas: amarelo #ffd60a, rosa #ff6b9d, ciano #4cc9f0, lima #a6eb3c.
   Carregado no lugar de style.qss (fritchii_ui.cpp), para merges do Fritchii ficarem limpos. */

* { font-family: "Segoe UI"; }

QMainWindow, QDialog, QWidget#FritchiiHome { background: #faf9f5; color: #141413; }

QToolTip {
    background: #ffd60a;
    color: #141413;
    border: 2px solid #141413;
    padding: 6px 8px;
    font-weight: 700;
}

QMenuBar {
    background: #faf9f5;
    border-bottom: 3px solid #141413;
    font-weight: 700;
}
QMenuBar::item { padding: 6px 12px; background: transparent; }
QMenuBar::item:selected { background: #ffd60a; color: #141413; }

QMenu {
    background: #ffffff;
    border: 3px solid #141413;
    border-right-width: 6px;
    border-bottom-width: 6px;
    padding: 4px;
}
QMenu::item { padding: 7px 30px 7px 14px; color: #141413; font-weight: 600; }
QMenu::item:selected { background: #ff6b9d; color: #141413; }
QMenu::item:disabled { color: #827e76; }
QMenu::separator { height: 2px; background: #141413; margin: 4px 6px; }
QMenu::indicator { width: 14px; height: 14px; left: 6px; }

QPushButton {
    background: #ffffff;
    color: #141413;
    border: 3px solid #141413;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-radius: 0;
    padding: 6px 18px;
    font-weight: 800;
}
QPushButton:hover { background: #4cc9f0; }
QPushButton:pressed {
    border-right-width: 3px;
    border-bottom-width: 3px;
    margin-left: 3px;
    margin-top: 3px;
}
QPushButton:default { background: #ffd60a; }
QPushButton:default:hover { background: #ffe14d; }
QPushButton:disabled { color: #827e76; background: #d6d3ca; border-color: #827e76; }

QLineEdit, QComboBox, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox {
    background: #ffffff;
    color: #141413;
    border: 3px solid #141413;
    border-radius: 0;
    padding: 5px 9px;
    font-weight: 600;
    selection-background-color: #ff6b9d;
    selection-color: #141413;
}
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus { background: #fffbe0; border-color: #141413; }
QComboBox:hover, QLineEdit:hover { background: #fffbe0; }
QComboBox:disabled, QLineEdit:disabled { background: #d6d3ca; color: #827e76; border-color: #827e76; }
QComboBox::drop-down {
    border: none;
    border-left: 3px solid #141413;
    width: 26px;
    background: #ffd60a;
}
QComboBox::down-arrow { image: url(:/fritchii/icons/chevron-down.svg); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background: #ffffff;
    color: #141413;
    border: 3px solid #141413;
    padding: 2px;
    outline: none;
    selection-background-color: #ff6b9d;
    selection-color: #141413;
}

QCheckBox, QRadioButton { spacing: 10px; color: #141413; font-weight: 600; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 3px solid #141413;
    border-radius: 0;
    background: #ffffff;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover { background: #fffbe0; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #a6eb3c;
    image: url(:/fritchii/icons/check.svg);
}
QCheckBox::indicator:disabled { background: #d6d3ca; border-color: #827e76; }

QGroupBox {
    background: #ffffff;
    border: 3px solid #141413;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-radius: 0;
    margin-top: 30px;
    padding: 16px 12px 10px 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0;
    padding: 2px 10px;
    background: #141413;
    color: #ffd60a;
    font-weight: 900;
}

QTabWidget::pane { border: none; }
QTabBar::tab {
    background: #ffffff;
    color: #141413;
    padding: 7px 14px;
    border: 3px solid #141413;
    margin-right: 6px;
    font-weight: 800;
}
QTabBar::tab:hover { background: #4cc9f0; }
QTabBar::tab:selected { background: #ffd60a; }

QScrollBar:vertical { background: #faf9f5; width: 14px; margin: 0; border-left: 2px solid #141413; }
QScrollBar:horizontal { background: #faf9f5; height: 14px; margin: 0; border-top: 2px solid #141413; }
QScrollBar::handle:vertical { background: #141413; min-height: 32px; margin: 3px; }
QScrollBar::handle:horizontal { background: #141413; min-width: 32px; margin: 3px; }
QScrollBar::handle:hover { background: #ff6b9d; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QHeaderView::section {
    background: #141413;
    color: #faf9f5;
    border: none;
    border-right: 2px solid #faf9f5;
    padding: 6px 10px;
    font-weight: 800;
}
QTreeView, QListView, QTableView {
    background: #ffffff;
    color: #141413;
    border: 3px solid #141413;
    outline: none;
}
QTreeView::item, QListView::item { padding: 4px; }
QTreeView::item:hover, QListView::item:hover { background: #fffbe0; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background: #ff6b9d;
    color: #141413;
}

QSlider::groove:horizontal { height: 8px; background: #ffffff; border: 2px solid #141413; }
QSlider::sub-page:horizontal { background: #a6eb3c; border: 2px solid #141413; }
QSlider::handle:horizontal {
    background: #ffd60a;
    border: 3px solid #141413;
    width: 14px;
    height: 18px;
    margin: -8px 0;
    border-radius: 0;
}

QProgressBar {
    background: #ffffff;
    border: 3px solid #141413;
    border-radius: 0;
    text-align: center;
    color: #141413;
    font-weight: 800;
}
QProgressBar::chunk { background: #a6eb3c; }

QStatusBar { background: #141413; color: #faf9f5; }
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #faf9f5; padding: 0 6px; font-weight: 700; }
QPushButton#TogglableStatusBarButton, QPushButton#DockingStatusBarButton,
QPushButton#OotFpsStatusBarButton, QPushButton#GPUStatusBarButton,
QPushButton#RendererStatusBarButton, QPushButton#RefreshButton {
    background: transparent;
    border: none;
    margin: 0;
    color: #faf9f5;
    padding: 3px 10px;
    font-weight: 800;
}
QPushButton#TogglableStatusBarButton:hover, QPushButton#DockingStatusBarButton:hover,
QPushButton#OotFpsStatusBarButton:hover, QPushButton#GPUStatusBarButton:hover,
QPushButton#RendererStatusBarButton:hover, QPushButton#RefreshButton:hover {
    background: #ffd60a;
    color: #141413;
}
QPushButton#OotFpsStatusBarButton { color: #a6eb3c; }

/* Barra lateral das configurações */
QListWidget#selectorList { background: transparent; border: none; outline: none; }
QListWidget#selectorList::item {
    padding: 8px 14px;
    margin: 3px 6px 3px 0;
    color: #141413;
    font-weight: 800;
    border: 3px solid transparent;
}
QListWidget#selectorList::item:hover { background: #fffbe0; border-color: #141413; }
QListWidget#selectorList::item:selected { background: #ffd60a; color: #141413; border-color: #141413; }

/* Novidades e atualização */
QLabel#FritchiiDialogTitle { font-family: "Arial Black"; font-size: 24px; color: #141413; }
QTextBrowser#FritchiiNotes { background: #ffffff; border: 3px solid #141413; font-size: 15px; color: #141413; }

/* Preparando shaders (fritchii/precompile_gate.cpp) */
QDialog#FritchiiPrepare { background: #faf9f5; }
QLabel#FritchiiLead { font-size: 16px; color: #141413; font-weight: 600; }
QProgressBar#FritchiiPrepareBar { background: #ffffff; border: 3px solid #141413; }
QProgressBar#FritchiiPrepareBar::chunk { background: #ff6b9d; }
QLabel#FritchiiStatusNote { color: #ffd60a; padding: 0 10px; font-weight: 800; }

/* Barra de controles dentro do jogo (fritchii/game_controls.cpp) */
QToolButton#FritchiiStripButton { background: transparent; border: none; }
QToolButton#FritchiiStripButton:hover { background: #ffd60a; }
QToolButton#FritchiiStripButton:pressed { background: #ff6b9d; }

/* Início e trilho lateral (fritchii/home.cpp) */
QWidget#FritchiiRail { background: #141413; }
QToolButton#FritchiiRailButton {
    background: transparent;
    border: 3px solid transparent;
    padding: 9px;
}
QToolButton#FritchiiRailButton:hover { background: #4cc9f0; border-color: #faf9f5; }
QToolButton#FritchiiRailButton:checked { background: #ffd60a; border-color: #faf9f5; }
QLabel#FritchiiHeroTitle { font-family: "Arial Black"; font-size: 32px; color: #141413; }
QLabel#FritchiiSection {
    font-size: 13px;
    color: #141413;
    font-weight: 900;
    text-transform: uppercase;
}
QPushButton#FritchiiPlay {
    background: #ffd60a;
    color: #141413;
    border: 3px solid #141413;
    border-right-width: 7px;
    border-bottom-width: 7px;
    min-height: 44px;
    max-height: 50px;
    padding: 0 30px;
    font-family: "Arial Black";
    font-size: 17px;
}
QPushButton#FritchiiPlay:hover { background: #a6eb3c; }
QPushButton#FritchiiPlay:pressed {
    border-right-width: 3px;
    border-bottom-width: 3px;
    margin-left: 4px;
    margin-top: 4px;
}
QToolButton#FritchiiTile {
    background: #ffffff;
    border: 3px solid #141413;
    padding: 8px;
    color: #141413;
    font-size: 13px;
    font-weight: 800;
}
QToolButton#FritchiiTile:hover { background: #4cc9f0; }
