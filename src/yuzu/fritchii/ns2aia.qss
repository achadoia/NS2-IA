/* NS2-IA (Nintendo Switch 2 Achado IA): escuro e calmo, com um so destaque (amarelo #ffd60a).
   Bordas finas cinza; o amarelo marca foco, selecao, titulos e o botao principal.
   Carregado no lugar de style.qss (fritchii_ui.cpp), para merges do Fritchii ficarem limpos. */

* { font-family: "Segoe UI"; }

QMainWindow, QDialog, QWidget#FritchiiHome { background: #161615; color: #ecebe6; }
QWidget { color: #ecebe6; }
QLabel { background: transparent; }

QToolTip {
    background: #232321;
    color: #ecebe6;
    border: 1px solid #ffd60a;
    padding: 6px 8px;
}

/* ---------- barra de menus e menus ---------- */
QMenuBar {
    background: #161615;
    color: #ecebe6;
    border-bottom: 1px solid #2e2e2b;
}
QMenuBar::item { padding: 6px 12px; background: transparent; color: #ecebe6; }
QMenuBar::item:selected { background: #2a2a27; color: #ffd60a; }

QMenu {
    background: #1e1e1c;
    color: #ecebe6;
    border: 1px solid #3a3a36;
    padding: 4px;
}
QMenu::item { padding: 7px 30px 7px 14px; color: #ecebe6; }
QMenu::item:selected { background: #ffd60a; color: #161615; }
QMenu::item:disabled { color: #6e6c66; }
QMenu::separator { height: 1px; background: #33332f; margin: 4px 6px; }
QMenu::indicator { width: 14px; height: 14px; left: 6px; }

/* ---------- botoes ---------- */
QPushButton {
    background: #232321;
    color: #ecebe6;
    border: 1px solid #45443f;
    border-bottom: 3px solid #0c0c0b;
    border-radius: 0;
    padding: 6px 16px;
    font-weight: 600;
}
QPushButton:hover { border-color: #ffd60a; border-bottom-color: #0c0c0b; color: #ffffff; }
QPushButton:pressed { background: #1a1a18; border-bottom-width: 1px; margin-top: 2px; }
QPushButton:default { background: #ffd60a; color: #161615; border: 1px solid #ffd60a; border-bottom: 3px solid #8a7300; font-weight: 700; }
QPushButton:default:hover { background: #ffe14d; }
QPushButton:disabled { color: #6e6c66; background: #1c1c1a; border-color: #2e2e2b; }
QToolButton { color: #ecebe6; }

/* ---------- campos ---------- */
QLineEdit, QComboBox, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QKeySequenceEdit {
    background: #10100f;
    color: #ecebe6;
    border: 1px solid #3a3a36;
    border-radius: 0;
    padding: 5px 8px;
    selection-background-color: #ffd60a;
    selection-color: #161615;
}
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus { border-color: #ffd60a; }
QComboBox:hover, QLineEdit:hover, QSpinBox:hover { border-color: #5a5953; }
QComboBox:disabled, QLineEdit:disabled, QSpinBox:disabled {
    background: #1a1a18; color: #6e6c66; border-color: #2a2a27;
}
QComboBox::drop-down { border: none; width: 26px; background: transparent; }
QComboBox::down-arrow { image: url(:/fritchii/icons/chevron-down.svg); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background: #1e1e1c;
    color: #ecebe6;
    border: 1px solid #3a3a36;
    padding: 2px;
    outline: none;
    selection-background-color: #ffd60a;
    selection-color: #161615;
}

QCheckBox, QRadioButton { spacing: 10px; color: #ecebe6; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #5a5953;
    border-radius: 0;
    background: #10100f;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #ffd60a; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #ffd60a;
    border-color: #ffd60a;
    image: url(:/fritchii/icons/check.svg);
}
QCheckBox::indicator:disabled { background: #1a1a18; border-color: #2a2a27; }
QCheckBox:disabled, QRadioButton:disabled { color: #6e6c66; }

/* ---------- grupos e abas ---------- */
QGroupBox {
    background: rgba(22, 22, 21, 225);
    border: 1px solid #33332f;
    border-left: 3px solid #ffd60a;
    border-radius: 0;
    margin-top: 28px;
    padding: 16px 12px 10px 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0;
    padding: 2px 4px;
    color: #ffd60a;
    font-weight: 700;
    font-size: 15px;
}

QTabWidget::pane { border: none; background: transparent; }
QTabWidget > QWidget, QTabWidget QStackedWidget { background: transparent; }
QTabBar { background: transparent; }
QTabBar::tab {
    background: transparent;
    color: #a9a79f;
    padding: 8px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 2px;
    font-weight: 600;
}
QTabBar::tab:hover { color: #ecebe6; border-bottom-color: #5a5953; }
QTabBar::tab:selected { color: #ffd60a; border-bottom-color: #ffd60a; }

/* as paginas ficam transparentes para a arte do fundo aparecer */
QScrollArea, QScrollArea > QWidget, QScrollArea > QWidget > QWidget, QStackedWidget {
    background: transparent;
}

QScrollBar:vertical { background: transparent; width: 10px; margin: 0; border: none; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; border: none; }
QScrollBar::handle:vertical { background: #45443f; min-height: 32px; margin: 2px; }
QScrollBar::handle:horizontal { background: #45443f; min-width: 32px; margin: 2px; }
QScrollBar::handle:hover { background: #ffd60a; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QHeaderView::section {
    background: #1e1e1c;
    color: #a9a79f;
    border: none;
    border-bottom: 1px solid #3a3a36;
    padding: 6px 8px;
    font-weight: 600;
}
QTreeView, QListView, QTableView, QTreeWidget, QListWidget, QTableWidget {
    background: rgba(16, 16, 15, 225);
    color: #ecebe6;
    border: 1px solid #33332f;
    outline: none;
}
QTreeView::item, QListView::item { padding: 4px; }
QTreeView::item:hover, QListView::item:hover { background: rgba(255, 255, 255, 14); }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background: rgba(255, 214, 10, 45);
    color: #ffffff;
}

QSlider::groove:horizontal { height: 4px; background: #3a3a36; }
QSlider::sub-page:horizontal { background: #ffd60a; }
QSlider::handle:horizontal {
    background: #ecebe6;
    width: 12px;
    height: 16px;
    margin: -6px 0;
    border-radius: 0;
}
QSlider::handle:horizontal:hover { background: #ffd60a; }

QProgressBar {
    background: #10100f;
    border: 1px solid #3a3a36;
    border-radius: 0;
    text-align: center;
    color: #ecebe6;
}
QProgressBar::chunk { background: #ffd60a; }

QStatusBar { background: #10100f; color: #ecebe6; border-top: 1px solid #2e2e2b; }
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #a9a79f; padding: 0 6px; }
QPushButton#TogglableStatusBarButton, QPushButton#DockingStatusBarButton,
QPushButton#OotFpsStatusBarButton, QPushButton#GPUStatusBarButton,
QPushButton#RendererStatusBarButton, QPushButton#RefreshButton {
    background: transparent;
    border: none;
    margin: 0;
    color: #a9a79f;
    padding: 3px 10px;
    font-weight: 700;
}
QPushButton#TogglableStatusBarButton:hover, QPushButton#DockingStatusBarButton:hover,
QPushButton#OotFpsStatusBarButton:hover, QPushButton#GPUStatusBarButton:hover,
QPushButton#RendererStatusBarButton:hover, QPushButton#RefreshButton:hover {
    background: #2a2a27;
    color: #ffd60a;
}
QPushButton#OotFpsStatusBarButton { color: #ffd60a; }

/* ---------- janela de configuracoes ---------- */
QListWidget#selectorList {
    background: transparent;
    border: none;
    border-right: 1px solid #33332f;
    outline: none;
    padding: 6px 8px 150px 6px;
}
QListWidget#selectorList::item {
    padding: 10px 12px;
    margin: 2px 0;
    color: #cfcdc6;
    font-weight: 600;
    font-size: 15px;
    border: none;
    border-left: 3px solid transparent;
}
QListWidget#selectorList::item:hover { background: rgba(255, 255, 255, 12); color: #ffffff; }
QListWidget#selectorList::item:selected {
    background: rgba(255, 214, 10, 40);
    color: #ffd60a;
    border-left: 3px solid #ffd60a;
}
QDialogButtonBox QPushButton { min-width: 100px; }

/* Novidades e atualizacao */
QLabel#FritchiiDialogTitle { font-size: 24px; font-weight: 700; color: #ffd60a; }
QTextBrowser#FritchiiNotes { background: #10100f; border: 1px solid #33332f; font-size: 15px; color: #ecebe6; }

/* Preparando shaders (fritchii/precompile_gate.cpp) */
QDialog#FritchiiPrepare { background: #161615; }
QLabel#FritchiiLead { font-size: 16px; color: #ecebe6; }
QProgressBar#FritchiiPrepareBar { background: #10100f; border: 1px solid #3a3a36; }
QProgressBar#FritchiiPrepareBar::chunk { background: #ffd60a; }
QLabel#FritchiiStatusNote { color: #ffd60a; padding: 0 10px; font-weight: 700; }

/* Barra de controles dentro do jogo (fritchii/game_controls.cpp) */
QToolButton#FritchiiStripButton { background: transparent; border: none; }
QToolButton#FritchiiStripButton:hover { background: #2a2a27; }
QToolButton#FritchiiStripButton:pressed { background: #ffd60a; }

/* Inicio antigo do Fritchii (so com NS2_FRITCHII_HOME=1) */
QWidget#FritchiiRail { background: #10100f; }
QToolButton#FritchiiRailButton { background: transparent; border: none; padding: 10px; }
QToolButton#FritchiiRailButton:hover { background: #2a2a27; }
QToolButton#FritchiiRailButton:checked { background: rgba(255, 214, 10, 45); }
QLabel#FritchiiHeroTitle { font-size: 30px; font-weight: 700; color: #ecebe6; }
QLabel#FritchiiSection { font-size: 13px; color: #a9a79f; font-weight: 700; }
QPushButton#FritchiiPlay {
    background: #ffd60a;
    color: #161615;
    border: none;
    border-bottom: 3px solid #8a7300;
    min-height: 44px;
    max-height: 48px;
    padding: 0 30px;
    font-size: 16px;
    font-weight: 700;
}
QPushButton#FritchiiPlay:hover { background: #ffe14d; }
QToolButton#FritchiiTile { background: #1e1e1c; border: 1px solid #33332f; padding: 8px; color: #ecebe6; font-size: 13px; }
QToolButton#FritchiiTile:hover { border-color: #ffd60a; }

/* ===== Inicio NS2-IA: lista de jogos sobre a arte (fritchii/ns2_inicio.cpp) ===== */
QWidget#Ns2Inicio QTreeView, QWidget#Ns2Inicio QListView {
    background: transparent;
    border: none;
    color: #ecebe6;
    font-size: 15px;
    outline: none;
}
QWidget#Ns2Inicio QTreeView::item, QWidget#Ns2Inicio QListView::item {
    background: rgba(18, 18, 17, 225);
    border-bottom: 1px solid rgba(255, 255, 255, 14);
    padding: 6px 4px;
    color: #ecebe6;
}
QWidget#Ns2Inicio QTreeView::item:hover, QWidget#Ns2Inicio QListView::item:hover {
    background: rgba(40, 40, 37, 235);
}
QWidget#Ns2Inicio QTreeView::item:selected, QWidget#Ns2Inicio QListView::item:selected {
    background: rgba(64, 56, 20, 240);
    color: #ffffff;
}
QWidget#Ns2Inicio QTreeView::branch { background: rgba(18, 18, 17, 225); }
QWidget#Ns2Inicio QTreeView::branch:selected { background: rgba(64, 56, 20, 240); }
QWidget#Ns2Inicio QHeaderView { background: transparent; border: none; }
QWidget#Ns2Inicio QHeaderView::section {
    background: rgba(18, 18, 17, 235);
    color: #ffd60a;
    border: none;
    border-bottom: 2px solid #ffd60a;
    padding: 8px 8px;
    font-weight: 700;
    font-size: 14px;
}
QWidget#Ns2Inicio QHeaderView::section:hover { background: rgba(40, 40, 37, 240); }
QWidget#Ns2Inicio QScrollBar:vertical { background: transparent; border: none; width: 10px; }
QWidget#Ns2Inicio QScrollBar::handle:vertical { background: #45443f; margin: 2px; }
QWidget#Ns2Inicio QScrollBar::handle:vertical:hover { background: #ffd60a; }
QWidget#Ns2Inicio QScrollBar:horizontal { background: transparent; border: none; height: 10px; }
QWidget#Ns2Inicio QScrollBar::handle:horizontal { background: #45443f; margin: 2px; }
/* barra de filtro embaixo */
QWidget#Ns2Inicio QLabel { color: #a9a79f; font-weight: 600; font-size: 14px; }
QWidget#Ns2Inicio QLineEdit {
    background: rgba(16, 16, 15, 235);
    color: #ecebe6;
    border: 1px solid #45443f;
    padding: 7px 10px;
    font-size: 15px;
}
QWidget#Ns2Inicio QLineEdit:focus { border-color: #ffd60a; }
QWidget#Ns2Inicio QToolButton {
    background: #232321;
    color: #ecebe6;
    border: 1px solid #45443f;
    font-weight: 700;
    min-width: 30px;
    min-height: 30px;
}
QWidget#Ns2Inicio QToolButton:hover { border-color: #ffd60a; color: #ffd60a; }
